# Copy to .env and fill as needed. Both are optional.

# Local LLM — absolute path to a GGUF model file (Qwen2.5-7B Q4_K_M recommended).
# Enables real reasoning for all 31 agents via llama.cpp. Requires
# `pip install llama-cpp-python` with a build matching your GPU backend.
# NEXUS_LLM_PATH=D:/models/qwen2.5-7b-instruct-q4_k_m.gguf

# Gemini cloud fallback — used when NEXUS_LLM_PATH is unset or load fails.
# Without either, the 31 agents run their deterministic `_fallback_output()`.
# GEMINI_API_KEY=

# HuggingFace Spaces endpoint for the Compute Mesh. Point this at a Space
# running a Gradio or FastAPI app that accepts {"data": [workload, payload]}.
# Without it, the HF endpoint falls back to the local 1-second stub.
# NEXUS_HF_SPACE=https://your-username-your-space.hf.space
# NEXUS_HF_PREDICT_PATH=/api/predict   # Gradio v4 default; use /run/predict for v3
# HF_TOKEN=                            # required only for private Spaces

# Modal App (second real cloud backend after HF Spaces).
# Requires: pip install modal, then `modal token new` for one-time auth,
# then deploy a `nexus-fabric-worker` App with a `run(workload, payload)` func.
# NEXUS_MODAL_APP=nexus-fabric-worker
